PORT=3000

# Razorpay — https://dashboard.razorpay.com/app/keys
# KEY_ID is also needed on the frontend as VITE_RAZORPAY_KEY_ID (public, safe to expose).
# KEY_SECRET and WEBHOOK_SECRET must stay server-side only — never in .env.local or VITE_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
