PORT=3000

# Razorpay — https://dashboard.razorpay.com/app/keys
# KEY_ID is also needed on the frontend as VITE_RAZORPAY_KEY_ID (public, safe to expose).
# KEY_SECRET and WEBHOOK_SECRET must stay server-side only — never in .env.local or VITE_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase — service-role key (server-side ONLY, never in .env.local / VITE_*).
# The WhatsApp bot uses this to read the live catalogue and write orders on
# behalf of buyers identified by phone number (RLS can't identify them).
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Cloud API (Meta). Leave blank to run the bot in dry-run:
# POST /orders/whatsapp/simulate then drives the exact same flow without Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
